; in SMD-CWT
salted-merkle-array = [ +bstr-encoded-salted-merkle ]
bstr-encoded-salted-merkle = bstr .cbor salted-merkle-entries

; in SMD-KBT
salted-array-proofs = [ +bstr-encoded-salted-proof ]
bstr-encoded-salted-proof = bstr .cbor salted-merkle-proof

; where salted-claim, salted-element and decoy are already defined in {{SD-CWT}}
salted-merkle-entry = salted-claim / salted-element / decoy / salted-merkle-entry
salted-merkle-proof = salted-claim / salted-element / decoy / salted-merkle-proof

salted-merkle-entries = [ +salted-merkle-entry ]

salted-merkle-proof = [ +merkle-entry ] ; TODO

; repeated here
salted-claim = [
  bstr .size 16,     ; 128-bit salt
  any,               ; Claim Value
  (int / text)       ; Claim Key
]
salted-element = [
  bstr .size 16,     ; 128-bit salt
  any                ; Claim Value
]
decoy = [
  bstr .size 16      ; 128-bit salt
]

